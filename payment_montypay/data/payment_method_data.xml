<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================================================
         Primary MontyPay payment method
    ========================================================= -->
    <record id="payment_method_montypay" model="payment.method">
        <field name="name"><![CDATA[MontyPay Payment Gateway]]></field>
        <field name="code">montypay</field>
        <field name="sequence">1000</field>
        <field name="image" type="base64" file="payment_montypay/static/description/logo.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
    </record>

    <!-- =========================================================
         Card brands
    ========================================================= -->
    <record id="payment_method_visa_montypay" model="payment.method">
        <field name="sequence">1001</field>
        <field name="name">Visa</field>
        <field name="image" type="base64" file="payment_montypay/static/description/visa.svg"/>
        <field name="code">visa_montypay</field>
        <field name="primary_payment_method_id" eval="ref('payment_method_montypay')"/>
        <field name="active">True</field>
    </record>

    <record id="payment_method_master_montypay" model="payment.method">
        <field name="sequence">1002</field>
        <field name="name">Mastercard</field>
        <field name="image" type="base64" file="payment_montypay/static/description/mastercard.svg"/>
        <field name="code">master_montypay</field>
        <field name="primary_payment_method_id" eval="ref('payment_method_montypay')"/>
        <field name="active">True</field>
    </record>

    <record id="payment_method_amex_montypay" model="payment.method">
        <field name="sequence">1003</field>
        <field name="name">American Express</field>
        <field name="image" type="base64" file="payment_montypay/static/description/american_express.svg"/>
        <field name="code">amex_montypay</field>
        <field name="primary_payment_method_id" eval="ref('payment_method_montypay')"/>
        <field name="active">True</field>
    </record>

    <!-- =========================================================
         Digital wallets
    ========================================================= -->
    <record id="payment_method_apple_pay_montypay" model="payment.method">
        <field name="sequence">1004</field>
        <field name="name">Apple Pay</field>
        <field name="image" type="base64" file="payment_montypay/static/description/apple.svg"/>
        <field name="code">apple_pay_montypay</field>
        <field name="primary_payment_method_id" eval="ref('payment_method_montypay')"/>
        <field name="active">True</field>
    </record>

    <record id="payment_method_google_pay_montypay" model="payment.method">
        <field name="sequence">1005</field>
        <field name="name">Google Pay</field>
        <field name="image" type="base64" file="payment_montypay/static/description/google.svg"/>
        <field name="code">google_pay_montypay</field>
        <field name="primary_payment_method_id" eval="ref('payment_method_montypay')"/>
        <field name="active">True</field>
    </record>

</odoo>
