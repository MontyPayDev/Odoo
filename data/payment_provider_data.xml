<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_montypay" model="payment.provider">

        <!-- Clean name (what shows in UI) -->
        <field name="name">MontyPay</field>

        <!-- Internal identifier -->
        <field name="code">montypay</field>

        <!-- Enable provider -->
        <field name="state">enabled</field>

        <!-- Show on website -->
        <field name="is_published">True</field>

        <!-- Logo -->
        <field name="image_128" type="base64"
               file="payment_montypay/static/description/icon.png"/>

        <!-- Link to your module -->
        <field name="module_id" ref="base.module_payment_montypay"/>

        <!-- Payment method -->
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment_montypay.payment_method_montypay')])]"/>

    </record>

</odoo>